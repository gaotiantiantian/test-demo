# 仅放到 Vercel Project Settings -> Environment Variables，不要提交真实值。
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 可选：演示成功页使用；不代表真实权益发放。
DEMO_SERVICE_NAME=投顾服务
DEMO_SERVICE_END_DATE=2026-11-29

# 可选：本地网页跨域调用已部署 API 时配置，例如 http://127.0.0.1:5173。
ALLOWED_ORIGIN=

# 仅用于本地 Vite 调试远程 API；线上同域部署不需要。
VITE_USE_MOCK_API=true
VITE_API_BASE_URL=
